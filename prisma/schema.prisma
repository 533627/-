generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  DEPARTMENT_MANAGER
  EMPLOYEE
}

enum OperationsTeam {
  TEAM_ONE
  TEAM_TWO
}

enum BusinessModelStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum BusinessModelEventType {
  CREATED
  UPDATED
  ARCHIVED
  RESTORED
  DELETED
}

enum ProjectRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectRequestEventType {
  SUBMITTED
  APPROVED
  REJECTED
}

enum NotificationType {
  PROJECT_REQUEST_APPROVED
  PROJECT_REQUEST_REJECTED
  DIRECT_MESSAGE
}

enum ProjectStatus {
  PREPARING
  IN_PROGRESS
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ProjectMemberRole {
  LEAD
  MEMBER
}

enum ProjectEventType {
  CREATED
  STATUS_CHANGED
  LEAD_CHANGED
  MEMBER_ADDED
  MEMBER_REMOVED
  DEPARTMENT_ADDED
  DEPARTMENT_REMOVED
}

enum TaskStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  IN_PROGRESS
  PENDING_REVIEW
  NEEDS_REVISION
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskEventType {
  ASSIGNED
  ACCEPTED
  STARTED
  SUBMITTED
  REJECTED
  APPROVED
}

model Department {
  id                     String                        @id @default(uuid()) @db.Uuid
  code                   String                        @unique @db.VarChar(50)
  name                   String                        @unique @db.VarChar(100)
  isActive               Boolean                       @default(true)
  createdAt              DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                      @updatedAt @db.Timestamptz(3)
  members                User[]
  membershipOrigins      DepartmentMembershipHistory[] @relation("MembershipFromDepartment")
  membershipDestinations DepartmentMembershipHistory[] @relation("MembershipToDepartment")
  projectDepartments     ProjectDepartment[]
  messages               DepartmentMessage[]

  @@index([isActive])
  @@map("departments")
}

model User {
  id                          String                        @id
  name                        String
  email                       String                        @unique
  emailVerified               Boolean                       @default(false)
  image                       String?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  username                    String?                       @unique
  displayUsername             String?
  role                        UserRole                      @default(EMPLOYEE)
  isActive                    Boolean                       @default(true)
  departmentId                String?                       @db.Uuid
  department                  Department?                   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  operationsTeam              OperationsTeam?
  sessions                    Session[]
  accounts                    Account[]
  membershipChanges           DepartmentMembershipHistory[] @relation("MembershipChangedMember")
  performedMembershipChanges  DepartmentMembershipHistory[] @relation("MembershipChangedBy")
  createdBusinessModels       BusinessModel[]               @relation("BusinessModelCreatedBy")
  updatedBusinessModels       BusinessModel[]               @relation("BusinessModelUpdatedBy")
  businessModelEvents         BusinessModelEvent[]          @relation("BusinessModelEventActor")
  uploadedBusinessModelImages BusinessModelImage[]          @relation("BusinessModelImageUploadedBy")
  executionSuggestions        ExecutionSuggestion[]         @relation("ExecutionSuggestionAuthor")
  projectRequests             ProjectRequest[]              @relation("ProjectRequestApplicant")
  reviewedProjectRequests     ProjectRequest[]              @relation("ProjectRequestReviewer")
  projectRequestEvents        ProjectRequestEvent[]         @relation("ProjectRequestEventActor")
  notifications               Notification[]
  ledProjects                 Project[]                     @relation("ProjectLead")
  createdProjects             Project[]                     @relation("ProjectCreatedBy")
  projectMemberships          ProjectMember[]               @relation("ProjectMemberUser")
  addedProjectMembers         ProjectMember[]               @relation("ProjectMemberAddedBy")
  addedProjectDepartments     ProjectDepartment[]           @relation("ProjectDepartmentAddedBy")
  createdProjectConversations ProjectConversation[]         @relation("ProjectConversationCreatedBy")
  projectMessages             ProjectMessage[]              @relation("ProjectMessageAuthor")
  departmentMessages          DepartmentMessage[]           @relation("DepartmentMessageAuthor")
  sentDirectMessages          DirectMessage[]               @relation("DirectMessageSender")
  receivedDirectMessages      DirectMessage[]               @relation("DirectMessageRecipient")
  projectEvents               ProjectEvent[]                @relation("ProjectEventActor")
  assignedTasks               Task[]                        @relation("TaskAssignee")
  createdTasks                Task[]                        @relation("TaskAssignedBy")
  taskEvents                  TaskEvent[]                   @relation("TaskEventActor")

  @@index([role])
  @@index([isActive])
  @@index([departmentId])
  @@map("user")
}

model BusinessModel {
  id                   String                @id @default(uuid()) @db.Uuid
  title                String                @db.VarChar(200)
  category             String                @db.VarChar(100)
  targetPlatform       String                @db.VarChar(100)
  opportunity          String                @db.Text
  businessLogic        String                @db.Text
  executionPlan        String                @db.Text
  costAssumptions      String                @default("") @db.Text
  revenueAssumptions   String                @default("") @db.Text
  risks                String                @default("") @db.Text
  tags                 String[]              @default([])
  keywords             String[]              @default([])
  status               BusinessModelStatus   @default(ACTIVE)
  revision             Int                   @default(1)
  archivedAt           DateTime?             @db.Timestamptz(3)
  deletedAt            DateTime?             @db.Timestamptz(3)
  createdById          String
  createdBy            User                  @relation("BusinessModelCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById          String
  updatedBy            User                  @relation("BusinessModelUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  events               BusinessModelEvent[]
  images               BusinessModelImage[]
  executionSuggestions ExecutionSuggestion[]
  projectRequests      ProjectRequest[]
  projects             Project[]

  @@index([status, updatedAt])
  @@index([category])
  @@index([targetPlatform])
  @@index([tags], type: Gin)
  @@index([keywords], type: Gin)
  @@index([createdById])
  @@map("business_models")
}

model BusinessModelImage {
  id              String        @id @default(uuid()) @db.Uuid
  businessModelId String        @db.Uuid
  businessModel   BusinessModel @relation(fields: [businessModelId], references: [id], onDelete: Cascade)
  fileName        String        @db.VarChar(180)
  mimeType        String        @db.VarChar(50)
  size            Int
  data            Bytes
  uploadedById    String
  uploadedBy      User          @relation("BusinessModelImageUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@index([businessModelId, createdAt])
  @@index([uploadedById])
  @@map("business_model_images")
}

model ExecutionSuggestion {
  id              String          @id @default(uuid()) @db.Uuid
  businessModelId String          @db.Uuid
  businessModel   BusinessModel   @relation(fields: [businessModelId], references: [id], onDelete: Restrict)
  authorId        String
  author          User            @relation("ExecutionSuggestionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  content         String          @db.Text
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  projectRequest  ProjectRequest?

  @@index([businessModelId, createdAt])
  @@index([authorId])
  @@map("execution_suggestions")
}

model ProjectRequest {
  id              String                @id @default(uuid()) @db.Uuid
  businessModelId String                @db.Uuid
  businessModel   BusinessModel         @relation(fields: [businessModelId], references: [id], onDelete: Restrict)
  suggestionId    String                @unique @db.Uuid
  suggestion      ExecutionSuggestion   @relation(fields: [suggestionId], references: [id], onDelete: Restrict)
  proposedName    String                @db.VarChar(200)
  objective       String                @db.Text
  status          ProjectRequestStatus  @default(PENDING)
  version         Int                   @default(1)
  requestedById   String
  requestedBy     User                  @relation("ProjectRequestApplicant", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById    String?
  reviewedBy      User?                 @relation("ProjectRequestReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt      DateTime?             @db.Timestamptz(3)
  rejectionReason String?               @db.Text
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  events          ProjectRequestEvent[]
  project         Project?

  @@index([businessModelId, status, createdAt])
  @@index([requestedById, status, createdAt])
  @@index([reviewedById])
  @@map("project_requests")
}

model Project {
  id                    String               @id @default(uuid()) @db.Uuid
  name                  String               @db.VarChar(200)
  objective             String               @db.Text
  status                ProjectStatus        @default(PREPARING)
  revision              Int                  @default(1)
  sourceBusinessModelId String               @db.Uuid
  sourceBusinessModel   BusinessModel        @relation(fields: [sourceBusinessModelId], references: [id], onDelete: Restrict)
  sourceRequestId       String?              @unique @db.Uuid
  sourceRequest         ProjectRequest?      @relation(fields: [sourceRequestId], references: [id], onDelete: Restrict)
  leadId                String
  lead                  User                 @relation("ProjectLead", fields: [leadId], references: [id], onDelete: Restrict)
  createdById           String
  createdBy             User                 @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  startAt               DateTime             @default(now()) @db.Timestamptz(3)
  targetEndAt           DateTime?            @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)
  members               ProjectMember[]
  departments           ProjectDepartment[]
  conversation          ProjectConversation?
  events                ProjectEvent[]
  tasks                 Task[]

  @@index([status, updatedAt])
  @@index([sourceBusinessModelId])
  @@index([leadId])
  @@index([createdById])
  @@map("projects")
}

model Task {
  id              String       @id @default(uuid()) @db.Uuid
  projectId       String       @db.Uuid
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  title           String       @db.VarChar(200)
  description     String       @default("") @db.Text
  priority        TaskPriority @default(MEDIUM)
  status          TaskStatus   @default(PENDING_ACCEPTANCE)
  version         Int          @default(1)
  assigneeId      String
  assignee        User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedById    String
  assignedBy      User         @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  dueAt           DateTime     @db.Timestamptz(3)
  submissionNote  String?      @db.Text
  rejectionReason String?      @db.Text
  acceptedAt      DateTime?    @db.Timestamptz(3)
  startedAt       DateTime?    @db.Timestamptz(3)
  submittedAt     DateTime?    @db.Timestamptz(3)
  completedAt     DateTime?    @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  events          TaskEvent[]

  @@index([assigneeId, status, dueAt])
  @@index([assignedById, status, dueAt])
  @@index([projectId, status, dueAt])
  @@map("tasks")
}

model TaskEvent {
  id        String        @id @default(uuid()) @db.Uuid
  taskId    String        @db.Uuid
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actorId   String
  actor     User          @relation("TaskEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  type      TaskEventType
  version   Int
  note      String?       @db.Text
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([taskId, version])
  @@index([actorId])
  @@index([type, createdAt])
  @@map("task_events")
}

model ProjectEvent {
  id        String           @id @default(uuid()) @db.Uuid
  projectId String           @db.Uuid
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actorId   String
  actor     User             @relation("ProjectEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  type      ProjectEventType
  revision  Int
  details   Json
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([projectId, revision])
  @@index([actorId])
  @@index([type, createdAt])
  @@map("project_events")
}

model ProjectMember {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @db.Uuid
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  userId    String
  user      User              @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  role      ProjectMemberRole @default(MEMBER)
  addedById String
  addedBy   User              @relation("ProjectMemberAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  joinedAt  DateTime          @default(now()) @db.Timestamptz(3)
  removedAt DateTime?         @db.Timestamptz(3)

  @@unique([projectId, userId])
  @@index([userId, removedAt])
  @@index([addedById])
  @@map("project_members")
}

model ProjectDepartment {
  id           String     @id @default(uuid()) @db.Uuid
  projectId    String     @db.Uuid
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  addedById    String
  addedBy      User       @relation("ProjectDepartmentAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  addedAt      DateTime   @default(now()) @db.Timestamptz(3)
  removedAt    DateTime?  @db.Timestamptz(3)

  @@unique([projectId, departmentId])
  @@index([departmentId, removedAt])
  @@index([addedById])
  @@map("project_departments")
}

model ProjectConversation {
  id          String           @id @default(uuid()) @db.Uuid
  projectId   String           @unique @db.Uuid
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User             @relation("ProjectConversationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  messages    ProjectMessage[]

  @@index([createdById])
  @@map("project_conversations")
}

model ProjectMessage {
  id             String              @id @default(uuid()) @db.Uuid
  conversationId String              @db.Uuid
  conversation   ProjectConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  authorId       String
  author         User                @relation("ProjectMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  content        String              @db.VarChar(2000)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  @@index([conversationId, createdAt])
  @@index([authorId])
  @@map("project_messages")
}

model DepartmentMessage {
  id             String          @id @default(uuid()) @db.Uuid
  departmentId   String          @db.Uuid
  department     Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  authorId       String
  author         User            @relation("DepartmentMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  content        String          @db.VarChar(2000)
  operationsTeam OperationsTeam?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@index([departmentId, operationsTeam, createdAt])
  @@index([authorId])
  @@map("department_messages")
}

model DirectMessage {
  id          String    @id @default(uuid()) @db.Uuid
  senderId    String
  sender      User      @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipientId String
  recipient   User      @relation("DirectMessageRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  content     String    @db.VarChar(2000)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  readAt      DateTime? @db.Timestamptz(3)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt, createdAt])
  @@map("direct_messages")
}

model ProjectRequestEvent {
  id        String                  @id @default(uuid()) @db.Uuid
  requestId String                  @db.Uuid
  request   ProjectRequest          @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actorId   String
  actor     User                    @relation("ProjectRequestEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  type      ProjectRequestEventType
  version   Int
  note      String?                 @db.Text
  createdAt DateTime                @default(now()) @db.Timestamptz(3)

  @@unique([requestId, version])
  @@index([actorId])
  @@index([type, createdAt])
  @@map("project_request_events")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  type        NotificationType
  title       String           @db.VarChar(200)
  message     String           @db.Text
  resourceId  String
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  readAt      DateTime?        @db.Timestamptz(3)

  @@index([recipientId, isRead, createdAt])
  @@index([resourceId])
  @@map("notifications")
}

model BusinessModelEvent {
  id              String                 @id @default(uuid()) @db.Uuid
  businessModelId String                 @db.Uuid
  businessModel   BusinessModel          @relation(fields: [businessModelId], references: [id], onDelete: Restrict)
  actorId         String
  actor           User                   @relation("BusinessModelEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  type            BusinessModelEventType
  revision        Int
  snapshot        Json
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)

  @@unique([businessModelId, revision])
  @@index([actorId])
  @@index([type, createdAt])
  @@map("business_model_events")
}

model DepartmentMembershipHistory {
  id                 String          @id @default(uuid()) @db.Uuid
  memberId           String
  member             User            @relation("MembershipChangedMember", fields: [memberId], references: [id], onDelete: Restrict)
  fromDepartmentId   String?         @db.Uuid
  fromDepartment     Department?     @relation("MembershipFromDepartment", fields: [fromDepartmentId], references: [id], onDelete: Restrict)
  toDepartmentId     String          @db.Uuid
  toDepartment       Department      @relation("MembershipToDepartment", fields: [toDepartmentId], references: [id], onDelete: Restrict)
  fromOperationsTeam OperationsTeam?
  toOperationsTeam   OperationsTeam?
  changedById        String
  changedBy          User            @relation("MembershipChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  changedAt          DateTime        @default(now()) @db.Timestamptz(3)

  @@index([memberId, changedAt])
  @@index([fromDepartmentId])
  @@index([toDepartmentId])
  @@index([changedById])
  @@map("department_membership_history")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}
