# Better Auth requires an explicit base URL and a high-entropy secret of at least 32 characters.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# PostgreSQL connection used by Prisma. Replace with the deployment provider's URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/company_ops_terminal?schema=public
